{
  "name": "@statewalker/fsm-viewer",
  "version": "0.4.0",
  "description": "FSM Viewer",
  "keywords": [],
  "homepage": "https://github.com/statewalker/statewalker-fsm-viewer",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@statewalker/fsm": "workspace:*",
    "@statewalker/fsm-charts": "workspace:*"
  },
  "devDependencies": {
    "@observablehq/framework": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/lodash-es": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-config-standard-with-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "catalog:",
    "jsdom": "catalog:",
    "lodash-es": "catalog:",
    "tsup": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:statewalker/statewalker-fsm-viewer.git"
  },
  "scripts": {
    "build": "rm -fr ./dist && pnpm test && tsup",
    "dev": "observable preview",
    "watch": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublish": "pnpm test && pnpm build"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
